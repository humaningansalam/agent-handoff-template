      "required_stages": [
        "implementation",
        "callers_or_dependents",
        "tests"
      ],
      "success": "Existing provider-confirmed relations remain precise and current.",
      "repo_id": "gakza-app",
      "selector": {
        "symbol": "LocalRestaurantOrderAuthority",
        "in_file": "lib/runtime/local_store/local_restaurant_order_authority.dart"
      },
      "expected_paths": {
