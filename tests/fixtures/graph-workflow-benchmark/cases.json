{
  "schema": "repoctl.graph.workflow-benchmark",
  "schema_version": 1,
  "cases": [
    {
      "id": "basic-ml-predict",
      "repository": "Basic ML API",
      "question": "Trace /predict from HTTP entrypoint through ModelManager.predict to API and concurrency tests.",
      "required_stages": [
        "entrypoint",
        "implementation",
        "tests"
      ],
      "success": "All required stages have current source paths and typed provenance; missing tests is not reported as zero-impact.",
      "repo_id": "main",
      "selector": {
        "route": "/predict"
      },
      "expected_paths": {
        "entrypoints": [
          "src/api/model_routes.py"
        ],
        "implementation": [
          "src/core/model_manager.py"
        ],
        "tests": [
          "tests/test_predict.py",
          "tests/test_model_manager_concurrency.py"
        ]
      },
      "expected_statuses": [
        "partial",
        "found"
      ]
    },
    {
      "id": "kinport-audio-clock",
      "repository": "Kinport",
      "question": "Locate audio_clock Rust definitions, dependents, and relevant tests.",
      "required_stages": [
        "implementation",
        "callers_or_dependents",
        "tests"
      ],
      "success": "Rust precision is explicit as precise or partial; unsupported precision is not a zero-impact result.",
      "repo_id": "main",
      "selector": {
        "symbol": "audio_clock"
      },
      "expected_paths": {
        "implementation": [
          "crates/daemon/src/audio_clock.rs",
          "crates/daemon/src/main.rs",
          "crates/core/src/lib.rs"
        ],
        "tests": [
          "crates/core/src/lib.rs"
        ]
      },
      "expected_statuses": [
        "partial"
      ]
    },
    {
      "id": "gakza-dart-precision",
