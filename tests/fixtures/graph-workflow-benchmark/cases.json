          "lib/runtime/local_store/local_restaurant_order_authority.dart"
        ],
        "tests": [
          "test/local_restaurant_order_authority_test.dart"
        ]
      },
      "expected_statuses": [
        "partial",
        "found"
      ]
    },
    {
      "id": "cops-and-robbers-stale-empty",
      "repository": "Cops-and-Robbers",
      "question": "Distinguish a stale empty snapshot from current code, then compare relations after refresh.",
      "required_stages": [
        "current_source",
        "refresh",
        "implementation"
      ],
      "success": "Before refresh the result is stale/partial rather than zero-impact; after refresh current relations are returned.",
      "repo_id": "main",
      "selector": {
        "symbol": "main",
        "in_file": "lib/main.dart"
      },
      "expected_paths": {
        "implementation": [
          "lib/main.dart"
        ]
      },
      "expected_statuses": [
        "partial"
      ]
    }
  ]
